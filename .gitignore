# ==========================================
# 1. DEPENDENCIES (Thư mục cài đặt thư viện)
# ==========================================
**/node_modules/
.pnpm-store/
.yarn/

# ==========================================
# 2. BUILD OUTPUTS (Sản phẩm sau khi build)
# ==========================================
**/dist/
**/build/
*.gem
*.egg

# ==========================================
# 3. ENVIRONMENT VARIABLES (Bảo mật thông tin)
# ==========================================
**/.env
**/.env.local
**/.env.*.local
**/local.properties

# ==========================================
# 4. LOGS & DIAGNOSTICS (File log hệ thống)
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# 5. IDE & SYSTEM FILES (Cài đặt của máy/editor)
# ==========================================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db